        "t1_present": {
          "title": "T1 Present",
          "type": "boolean"
        },
        "t2_present": {
          "title": "T2 Present",
          "type": "boolean"
        },
        "t3_present": {
          "title": "T3 Present",
          "type": "boolean"
        }
      },
      "required": [
        "t1_present",
        "t2_present",
        "t3_present"
      ],
      "title": "Dscsa",
      "type": "object"
    },
    "ExceptionType": {
